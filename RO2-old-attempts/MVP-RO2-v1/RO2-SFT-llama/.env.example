# Copy this file to `.env` (same directory) and fill in real values.
# `.env` is git-ignored — NEVER commit real tokens.
#
# HF_TOKEN must have WRITE access. It is used to:
#   - download the base model Qwen/Qwen3-4B,
#   - download the (gated) PKU-Alignment/PKU-SafeRLHF dataset
#     (accept its terms on the dataset page first, with this same account),
#   - create + push the 3 private adapter repos:
#       er-abd/qwen3-4b-sft-harmlessness-pku-adapter-epoch1
#       er-abd/qwen3-4b-sft-harmlessness-pku-adapter-epoch2
#       er-abd/qwen3-4b-sft-harmlessness-pku-adapter-epoch3
#     and the throwaway sanity repo (…-sanitytest).
HF_TOKEN=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

