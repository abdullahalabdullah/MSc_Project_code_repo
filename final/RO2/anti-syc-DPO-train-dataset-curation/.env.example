# Copy to .env (module dir or RO2 repo root — load_dotenv searches upward) and fill in.
# HF token: TriviaQA is public, but the token is needed to push run backups /
# checkpoints and keeps parity with the rest of the repo.
HF_TOKEN=hf_xxx
# Optional: where HF models/datasets are cached (defaults to ~/.cache/huggingface)
HF_MODELS_CACHE_DIR=
# OpenAI key for gpt-5-mini (grading + wrong-answer generation — API stages only)
OPENAI_API_KEY=sk-xxx
