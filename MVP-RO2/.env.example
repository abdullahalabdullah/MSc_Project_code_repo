# Copy this file to `.env` (same directory) and fill in real values.
# `.env` is git-ignored — NEVER commit real tokens.
#
# HF_TOKEN must have WRITE access to your target hub repos:
#   - <username>/tulu3-8b-harmlessness-dpo-mvp            (final adapter)
#   - <username>/tulu3-8b-harmlessness-dpo-mvp-sanitytest (sanity-check throwaway)
# It is also used to download the (possibly gated) base model and to access
# PKU-SafeRLHF (accept its terms on the dataset page first).
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Not needed for training, but the downstream RO1 eval/monitor step (GPT-4o)
# reads it from this same .env.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
